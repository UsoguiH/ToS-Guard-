{
  "name": "tos-guard-demo",
  "version": "1.0.0",
  "private": true,
  "description": "Remotion demo video for the ToS Guard browser extension",
  "scripts": {
    "dev": "remotion studio src/index.ts",
    "render": "remotion render src/index.ts ToSGuardDemo ../assets/demo.mp4 --codec=h264",
    "render-gif": "remotion render src/index.ts ToSGuardDemo ../assets/demo.gif --codec=gif --every-nth-frame=2 --scale=0.5"
  },
  "dependencies": {
    "@remotion/cli": "4.0.380",
    "react": "19.0.0",
    "react-dom": "19.0.0",
    "remotion": "4.0.380"
  },
  "devDependencies": {
    "@types/react": "19.0.0",
    "@types/react-dom": "19.0.0",
    "typescript": "5.8.3"
  }
}
